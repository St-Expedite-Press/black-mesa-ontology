@prefix bmo:  <https://example.org/bmo/> .
@prefix up:   <https://example.org/upper/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ===========================================================================
# INITIAL REPORTING CROSSWALKS — v0.3
#
# These are project-local representations of external terms because NPDN and
# CAP do not publish the terms below as RDF identifiers intended for reuse.
# The source URL and literal notation are therefore part of the evidence.
#
# NPDN diagnostic confidence and CAP alert certainty are NOT the same semantic
# dimension. NPDN mappings below are direct where the diagnostic dispositions
# coincide. CAP is represented as an alert vocabulary, but direct mappings from
# diagnostic dispositions to CAP certainty are explicitly rejected: that
# translation belongs in a jurisdiction- and policy-specific reporting rule.
# ===========================================================================

bmo:NPDNDiagnosticConfidenceScheme a bmo:ExternalReportingScheme ;
    rdfs:label "NPDN NDR diagnostic confidence"@en ;
    dct:source <https://www.npdn.org/public/confidence_levels_definitions> .

bmo:NPDNConfirmedTerm a bmo:ExternalReportingTerm ;
    rdfs:label "NPDN Confirmed"@en ;
    skos:notation "Confirmed" ;
    dct:source <https://www.npdn.org/public/confidence_levels_definitions> .

bmo:NPDNSuspectedTerm a bmo:ExternalReportingTerm ;
    rdfs:label "NPDN Suspected"@en ;
    skos:notation "Suspected" ;
    dct:source <https://www.npdn.org/public/confidence_levels_definitions> .

bmo:NPDNNotDetectedTerm a bmo:ExternalReportingTerm ;
    rdfs:label "NPDN Not Detected"@en ;
    skos:notation "Not Detected" ;
    dct:source <https://www.npdn.org/public/confidence_levels_definitions> .

bmo:NPDNUndeterminedTerm a bmo:ExternalReportingTerm ;
    rdfs:label "NPDN Undetermined"@en ;
    skos:notation "Undetermined" ;
    dct:source <https://www.npdn.org/public/confidence_levels_definitions> .

bmo:CrosswalkNPDNConfirmed a bmo:ReportingCrosswalk ;
    up:crosswalkFrom bmo:Confirmed ;
    bmo:targetScheme bmo:NPDNDiagnosticConfidenceScheme ;
    up:crosswalkTo bmo:NPDNConfirmedTerm ;
    up:fidelity up:Exact ;
    rdfs:comment "Direct diagnostic-disposition mapping to the NPDN Confirmed term."@en .

bmo:CrosswalkNPDNSuspected a bmo:ReportingCrosswalk ;
    up:crosswalkFrom bmo:Suspected ;
    bmo:targetScheme bmo:NPDNDiagnosticConfidenceScheme ;
    up:crosswalkTo bmo:NPDNSuspectedTerm ;
    up:fidelity up:Exact ;
    rdfs:comment "Direct diagnostic-disposition mapping to the NPDN Suspected term. Sensor indications do not use this mapping."@en .

bmo:CrosswalkNPDNNotDetected a bmo:ReportingCrosswalk ;
    up:crosswalkFrom bmo:NotDetected ;
    bmo:targetScheme bmo:NPDNDiagnosticConfidenceScheme ;
    up:crosswalkTo bmo:NPDNNotDetectedTerm ;
    up:fidelity up:Exact ;
    rdfs:comment "Direct mapping of diagnostic Not Detected. It must not be generated from a survey with no anomaly and no diagnostic test."@en .

bmo:CrosswalkNPDNUndetermined a bmo:ReportingCrosswalk ;
    up:crosswalkFrom bmo:Undetermined ;
    bmo:targetScheme bmo:NPDNDiagnosticConfidenceScheme ;
    up:crosswalkTo bmo:NPDNUndeterminedTerm ;
    up:fidelity up:Exact ;
    rdfs:comment "Direct mapping of an undetermined diagnostic disposition."@en .

bmo:CrosswalkSensorIndicationToNPDN a bmo:ReportingCrosswalk ;
    up:crosswalkFrom bmo:SensorIndicationStage ;
    bmo:targetScheme bmo:NPDNDiagnosticConfidenceScheme ;
    up:fidelity up:NoMapping ;
    rdfs:comment "NPDN diagnostic confidence begins at the diagnostic record. A sensor-only pre-symptomatic indication is a different epistemic object and has no defensible direct mapping."@en .

# --- CAP 1.2 is an alert vocabulary, not a diagnostic vocabulary -----------

bmo:CAP12Scheme a bmo:ExternalReportingScheme ;
    rdfs:label "OASIS Common Alerting Protocol 1.2"@en ;
    dct:source <https://docs.oasis-open.org/emergency/cap/v1.2/CAP-v1.2.html> .

bmo:CAPCertaintyObservedTerm a bmo:ExternalReportingTerm ;
    rdfs:label "CAP certainty: Observed"@en ;
    skos:notation "Observed" ;
    dct:source <https://docs.oasis-open.org/emergency/cap/v1.2/CAP-v1.2.html> .

bmo:CAPCertaintyLikelyTerm a bmo:ExternalReportingTerm ;
    rdfs:label "CAP certainty: Likely"@en ;
    skos:notation "Likely" ;
    dct:source <https://docs.oasis-open.org/emergency/cap/v1.2/CAP-v1.2.html> .

bmo:CAPCertaintyPossibleTerm a bmo:ExternalReportingTerm ;
    rdfs:label "CAP certainty: Possible"@en ;
    skos:notation "Possible" ;
    dct:source <https://docs.oasis-open.org/emergency/cap/v1.2/CAP-v1.2.html> .

bmo:CAPCertaintyUnlikelyTerm a bmo:ExternalReportingTerm ;
    rdfs:label "CAP certainty: Unlikely"@en ;
    skos:notation "Unlikely" ;
    dct:source <https://docs.oasis-open.org/emergency/cap/v1.2/CAP-v1.2.html> .

bmo:CAPCertaintyUnknownTerm a bmo:ExternalReportingTerm ;
    rdfs:label "CAP certainty: Unknown"@en ;
    skos:notation "Unknown" ;
    dct:source <https://docs.oasis-open.org/emergency/cap/v1.2/CAP-v1.2.html> .

bmo:CrosswalkConfirmedToCAP a bmo:ReportingCrosswalk ;
    up:crosswalkFrom bmo:Confirmed ;
    bmo:targetScheme bmo:CAP12Scheme ;
    up:fidelity up:NoMapping ;
    rdfs:comment "Do not equate diagnostic Confirmed with CAP Observed. CAP certainty describes the subject event of an alert message; the appropriate CAP value must be produced by an explicit reporting rule."@en .

bmo:CrosswalkSuspectedToCAP a bmo:ReportingCrosswalk ;
    up:crosswalkFrom bmo:Suspected ;
    bmo:targetScheme bmo:CAP12Scheme ;
    up:fidelity up:NoMapping ;
    rdfs:comment "Do not map diagnostic Suspected directly to CAP Likely or Possible. Alert certainty is a separate policy-layer judgment."@en .

bmo:CrosswalkNotDetectedToCAP a bmo:ReportingCrosswalk ;
    up:crosswalkFrom bmo:NotDetected ;
    bmo:targetScheme bmo:CAP12Scheme ;
    up:fidelity up:NoMapping ;
    rdfs:comment "A diagnostic Not Detected result is not itself a CAP alert certainty value."@en .

bmo:CrosswalkUndeterminedToCAP a bmo:ReportingCrosswalk ;
    up:crosswalkFrom bmo:Undetermined ;
    bmo:targetScheme bmo:CAP12Scheme ;
    up:fidelity up:NoMapping ;
    rdfs:comment "An undetermined diagnostic disposition does not directly determine CAP alert certainty."@en .
