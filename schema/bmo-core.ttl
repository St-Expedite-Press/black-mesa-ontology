@prefix bmo:  <https://example.org/bmo/> .
@prefix up:   <https://example.org/upper/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# ===========================================================================
# DETECTION CORE — Phase 1 conceptual schema
#
# Pre-symptomatic agricultural pathogen detection: the chain from a sensed
# spectral anomaly through sample collection and field assay to a detection
# that a reporting network can consume.
#
# Every class here anchors to BFO 2.0 through upper/upper-core.ttl. The
# anchoring is enforced by shapes.ttl, so no class can be added without
# declaring what kind of thing it is.
#
# The four decisions this file encodes, argued in
# docs/detection-ontology-v0.2.md:
#   1. Detection is a chain of distinct objects with stated cardinalities.
#   2. A detection is an ASSERTION carrying evidence and provenance, not a
#      property stamped on a field.
#   3. Confidence is multi-axis and includes a pre-symptomatic tier that no
#      published enumeration provides.
#   4. Raw imagery never enters the graph; it is referenced by URI and
#      checksum from object storage.
# ===========================================================================

bmo: a owl:Ontology ;
    dct:title "Detection core"@en ;
    owl:versionInfo "0.1" ;
    owl:imports <https://example.org/upper/> ;
    rdfs:comment "Phase 1 detection core. Documented conceptual schema, not a fully axiomatised ontology: the formalisation beyond this is deliberately deferred, and what is deferred is recorded rather than left implicit."@en .

# ===========================================================================
# 1. PLACES — where things are observed and sampled
# A site in BFO is immaterial: the place, not the crop standing in it.
# ===========================================================================

bmo:Farm a owl:Class ;
    rdfs:subClassOf up:SurveyedSite ;
    rdfs:label "Farm"@en ;
    rdfs:comment "A managed holding under one operator. The unit at which access, consent, and reporting obligations attach."@en .

bmo:Field a owl:Class ;
    rdfs:subClassOf up:SurveyedSite ;
    rdfs:label "Field"@en ;
    rdfs:comment "A bounded cultivated area within a farm, normally under a single crop and management regime."@en .

bmo:Zone a owl:Class ;
    rdfs:subClassOf up:SurveyedSite ;
    rdfs:label "Zone"@en ;
    rdfs:comment "A sub-field area distinguished for sampling or management. The finest place at which a detection is asserted, because asserting at field level would overstate what a point sample supports."@en .

bmo:partOfSite a owl:ObjectProperty ;
    rdfs:subPropertyOf obo:BFO_0000050 ;
    rdfs:label "part of site"@en ;
    rdfs:comment "Zone to field, field to farm. A specialisation of BFO part-of rather than a parallel containment relation."@en ;
    rdfs:domain up:SurveyedSite ; rdfs:range up:SurveyedSite .

# ===========================================================================
# 2. PROCESSES — the acts that make up the chain
# ===========================================================================

bmo:Flight a owl:Class ;
    rdfs:subClassOf up:ObservationProcess ;
    rdfs:label "Flight"@en ;
    rdfs:comment """A single sortie over one or more sites, producing imagery and zero or more anomaly records.

Zero is the important cardinality: a sortie that finds nothing is a recorded event with a negative result, not an absence of data. Without it nobody can say how much of a season was surveyed."""@en .

bmo:SampleCollection a owl:Class ;
    rdfs:subClassOf up:SamplingProcess ;
    rdfs:label "Sample collection"@en ;
    rdfs:comment "The act of the sampling arm removing plant or soil material at a zone, producing a specimen."@en .

bmo:Assay a owl:Class ;
    rdfs:subClassOf up:AnalysisProcess ;
    rdfs:label "Assay"@en ;
    rdfs:comment "The confirmation analysis performed on a specimen, producing an assay result. Aligned with OBI's assay, which is likewise a planned process."@en ;
    rdfs:seeAlso obo:OBI_0000070 .

bmo:CustodyChain a owl:Class ;
    rdfs:subClassOf up:ProvenanceChain ;
    rdfs:label "Custody chain"@en ;
    rdfs:comment """The ordered whole of the acts producing a detection: flight, anomaly registration, collection, transfer, assay.

A process aggregate, not a document. A detection that cannot be resolved back along this chain is not evidence, and retrofitting the chain onto records created without it is what makes early records unusable."""@en .

# ===========================================================================
# 3. MATERIAL — what is physically handled
# ===========================================================================

bmo:Specimen a owl:Class ;
    rdfs:subClassOf up:Specimen ;
    rdfs:label "Specimen"@en ;
    rdfs:comment "Plant or soil material removed from a zone and held in a container. A material entity with its own identity: the same specimen can be split, re-assayed, or lost, and each of those is a fact about the specimen rather than about the zone."@en .

bmo:Container a owl:Class ;
    rdfs:subClassOf obo:BFO_0000030 ;
    rdfs:label "Container"@en ;
    rdfs:comment "The vessel a specimen is held in. Tracked because container identity is how custody is demonstrated between collection and assay."@en .

bmo:Host a owl:Class ;
    rdfs:subClassOf obo:BFO_0000027 ;
    rdfs:label "Host population"@en ;
    rdfs:comment "The crop plants occupying a zone. An object aggregate; the taxon it instantiates is referenced by NCBITaxon IRI rather than restated here."@en .

# ===========================================================================
# 4. INFORMATION — what the system records and concludes
# ===========================================================================

bmo:SpectralAnomaly a owl:Class ;
    rdfs:subClassOf up:DerivedDatum ;
    rdfs:label "Spectral anomaly"@en ;
    rdfs:comment """A record of a deviation detected in sensed imagery, localised to a zone.

Information, not a material condition: the anomaly is a pattern found in data that may or may not correspond to anything in the field. Treating it as a condition of the crop is the first place this domain slips from evidence into conclusion."""@en .

bmo:AssayResult a owl:Class ;
    rdfs:subClassOf obo:IAO_0000109 ;
    rdfs:label "Assay result"@en ;
    rdfs:comment "The datum produced by an assay: a determination for a target pathogen, with the assay's own detection limit and validity conditions attached."@en .

bmo:Detection a owl:Class ;
    rdfs:subClassOf up:Assertion ;
    rdfs:label "Detection"@en ;
    rdfs:comment """The assertion that a pathogen is present at a zone at a time.

Not a property of the zone, not a flag on a sample, not a row in a results table. An assertion carrying what concluded it, from what evidence, under which rule version, and with what confidence - because a detection that cannot be explained cannot be reviewed, and a rule change must not silently rewrite conclusions already drawn."""@en .

bmo:Alert a owl:Class ;
    rdfs:subClassOf obo:IAO_0000033 ;
    rdfs:label "Alert"@en ;
    rdfs:comment """A directive issued to a recipient on the basis of one or more detections.

Deliberately separate from Detection and joined by a defeasible link. Raising an alert has consequences for a grower, a programme, and possibly a market, and that decision is not the same claim as the determination that a pathogen is present. Keeping them apart lets alerting policy change without rewriting the diagnostic record."""@en .

bmo:ImageryReference a owl:Class ;
    rdfs:subClassOf up:InformationArtifact ;
    rdfs:label "Imagery reference"@en ;
    rdfs:comment """A pointer to imagery held in object storage: a URI, a checksum, and the capture parameters needed to interpret it.

THE GRAPH BOUNDARY. Raw spectral imagery is never tiled into the graph. At ten thousand farms over five years the correct architecture is on the order of 373 million triples; with imagery in the graph it is on the order of 248 billion, a factor of roughly 665. The failure is not gradual - query planning, indexing, and backup economics all change character - so it cannot be deferred and corrected later by adding hardware."""@en .

bmo:ConfidenceAssessment a owl:Class ;
    rdfs:subClassOf up:ConfidenceAssessment ;
    rdfs:label "Confidence assessment"@en ;
    rdfs:comment "The multi-axis confidence attached to a detection. A single number cannot distinguish a calibrated model output from an expert guess rendered as a decimal."@en .

bmo:ConfidenceTier a owl:Class ;
    rdfs:subClassOf up:ConceptualUnit ;
    rdfs:label "Confidence tier"@en ;
    rdfs:comment "A term in the adopted diagnostic confidence enumeration, extended with the pre-symptomatic tier."@en .

bmo:DetectionLimit a owl:Class ;
    rdfs:subClassOf up:ThresholdSpecification ;
    rdfs:label "Detection limit"@en ;
    rdfs:comment "The concentration below which an assay cannot distinguish presence from absence. A specification: chosen and validated rather than discovered, so it carries its validation evidence."@en .

bmo:ObservationRequirement a owl:Class ;
    rdfs:subClassOf up:RequirementSpecification ;
    rdfs:label "Observation requirement"@en ;
    rdfs:comment "A request for the observation that would most reduce uncertainty: target property, required accuracy, spatial support, purpose, acceptable methods. Observer-neutral by construction."@en .

bmo:ReportingCrosswalk a owl:Class ;
    rdfs:subClassOf up:Crosswalk ;
    rdfs:label "Reporting crosswalk"@en ;
    rdfs:comment "A mapping from an internal term to an external reporting vocabulary, carrying direction and fidelity. Entries with fidelity up:NoMapping are the valuable output: the pre-symptomatic tier is the known case."@en .

# ===========================================================================
# 5. THE CONFIDENCE ENUMERATION
#
# The four adopted levels retain their published meaning; the pre-symptomatic
# tier is added below them and is the one term here that no external
# vocabulary provides.
# ===========================================================================

bmo:Confirmed a bmo:ConfidenceTier ;
    rdfs:label "Confirmed"@en ; skos:notation "CONF" ;
    bmo:tierRank 1 ; bmo:presupposesSymptoms true ;
    rdfs:comment "Adopted level. Diagnosis established to the standard the receiving network requires."@en .

bmo:Suspected a bmo:ConfidenceTier ;
    rdfs:label "Suspected"@en ; skos:notation "SUSP" ;
    bmo:tierRank 2 ; bmo:presupposesSymptoms true ;
    rdfs:comment "Adopted level. PRESUPPOSES VISIBLE SYMPTOMS - which is precisely why it cannot absorb a pre-symptomatic indication."@en .

bmo:NotDetected a bmo:ConfidenceTier ;
    rdfs:label "Not detected"@en ; skos:notation "ND" ;
    bmo:tierRank 4 ; bmo:presupposesSymptoms false ;
    rdfs:comment "Adopted level. The assay ran and returned negative, which is not the same as not having looked."@en .

bmo:Undetermined a bmo:ConfidenceTier ;
    rdfs:label "Undetermined"@en ; skos:notation "UND" ;
    bmo:tierRank 5 ; bmo:presupposesSymptoms false ;
    rdfs:comment "Adopted level. The assay ran and could not conclude."@en .

bmo:PreSymptomatic a bmo:ConfidenceTier ;
    rdfs:label "Pre-symptomatic indication"@en ; skos:notation "PRESYM" ;
    bmo:tierRank 3 ; bmo:presupposesSymptoms false ;
    up:epistemicStatus up:Hypothesis ;
    rdfs:comment """THE INVENTED TERM. A sensor-derived indication that a sample is warranted, carrying no claim that disease is present.

It licenses sampling and nothing else. It is NOT a weaker 'suspected': it is a different kind of claim, made on different evidence, warranting a different action, and modelling it as a lower value on the same scale would let it be compared numerically against claims it is not commensurate with.

It is also the term most at risk at every integration boundary, because mapping it to the nearest existing bucket is locally reasonable every time and cumulatively destroys the platform's distinguishing output. The schema cannot prevent that; it can only make the loss explicit through a ReportingCrosswalk with fidelity up:NoMapping."""@en .

bmo:tierRank a owl:DatatypeProperty ;
    rdfs:label "tier rank"@en ;
    rdfs:comment "Ordering within the enumeration. Ranks are not a probability scale and must not be arithmetic."@en ;
    rdfs:domain bmo:ConfidenceTier ; rdfs:range xsd:integer .

bmo:presupposesSymptoms a owl:DatatypeProperty ;
    rdfs:label "presupposes symptoms"@en ;
    rdfs:comment "Whether the tier can only be reached once symptoms are visible. The property that makes the gap in the adopted enumeration machine-readable."@en ;
    rdfs:domain bmo:ConfidenceTier ; rdfs:range xsd:boolean .

# ===========================================================================
# 6. THE CHAIN — relations, with cardinality carried by the shapes
# ===========================================================================

bmo:producedAnomaly a owl:ObjectProperty ;
    rdfs:subPropertyOf obo:RO_0002234 ;
    rdfs:label "produced anomaly"@en ;
    rdfs:comment "Flight to spectral anomaly. Zero or more."@en ;
    rdfs:domain bmo:Flight ; rdfs:range bmo:SpectralAnomaly .

bmo:triggeredCollection a owl:ObjectProperty ;
    rdfs:label "triggered collection"@en ;
    rdfs:comment "Anomaly to the collection act it prompted. Exactly one."@en ;
    rdfs:domain bmo:SpectralAnomaly ; rdfs:range bmo:SampleCollection .

bmo:yieldedSpecimen a owl:ObjectProperty ;
    rdfs:subPropertyOf obo:RO_0002234 ;
    rdfs:label "yielded specimen"@en ;
    rdfs:domain bmo:SampleCollection ; rdfs:range bmo:Specimen .

bmo:assayed a owl:ObjectProperty ;
    rdfs:subPropertyOf obo:RO_0002233 ;
    rdfs:label "assayed"@en ;
    rdfs:comment "The assay takes the specimen as input."@en ;
    rdfs:domain bmo:Assay ; rdfs:range bmo:Specimen .

bmo:producedResult a owl:ObjectProperty ;
    rdfs:subPropertyOf obo:RO_0002234 ;
    rdfs:label "produced result"@en ;
    rdfs:domain bmo:Assay ; rdfs:range bmo:AssayResult .

bmo:derivedFromResult a owl:ObjectProperty ;
    rdfs:subPropertyOf obo:RO_0001000 ;
    rdfs:label "derived from result"@en ;
    rdfs:domain bmo:Detection ; rdfs:range bmo:AssayResult .

bmo:concernsZone a owl:ObjectProperty ;
    rdfs:subPropertyOf obo:IAO_0000136 ;
    rdfs:label "concerns zone"@en ;
    rdfs:comment "What the detection is about. A specialisation of IAO is-about, because a detection is information about a place."@en ;
    rdfs:domain bmo:Detection ; rdfs:range bmo:Zone .

bmo:assertsPathogen a owl:ObjectProperty ;
    rdfs:label "asserts pathogen"@en ;
    rdfs:comment "The taxon asserted present, referenced by NCBITaxon IRI. Referenced, never restated: the taxonomy is reference data, not schema. The range is the NCBITaxon root, which states the expectation — values are NCBITaxon IRIs and nothing else — without importing 2.4 million taxa to say so."@en ;
    rdfs:domain bmo:Detection ; rdfs:range obo:NCBITaxon_1 .

bmo:hasTier a owl:ObjectProperty ;
    rdfs:label "has tier"@en ;
    rdfs:domain bmo:ConfidenceAssessment ; rdfs:range bmo:ConfidenceTier .

bmo:hasCustodyChain a owl:ObjectProperty ;
    rdfs:label "has custody chain"@en ;
    rdfs:domain bmo:Detection ; rdfs:range bmo:CustodyChain .

bmo:referencesImagery a owl:ObjectProperty ;
    rdfs:label "references imagery"@en ;
    rdfs:comment "Links an anomaly to the imagery it was found in, by reference. The only permitted relation to imagery: no tiling, no per-pixel triples."@en ;
    rdfs:domain bmo:SpectralAnomaly ; rdfs:range bmo:ImageryReference .

bmo:triggeredAlert a owl:ObjectProperty ;
    rdfs:label "triggered alert"@en ;
    rdfs:comment "Detection to alert. At most one, and frequently none."@en ;
    rdfs:domain bmo:Detection ; rdfs:range bmo:Alert .

# --- imagery reference payload --------------------------------------------

bmo:storageURI a owl:DatatypeProperty ;
    rdfs:label "storage URI"@en ;
    rdfs:domain bmo:ImageryReference ; rdfs:range xsd:anyURI .
bmo:checksum a owl:DatatypeProperty ;
    rdfs:label "checksum"@en ;
    rdfs:comment "Content hash, so the reference can be shown to resolve to the bytes that were analysed."@en ;
    rdfs:domain bmo:ImageryReference ; rdfs:range xsd:string .

# --- confidence axes, mirroring the upper module's contract ---------------

bmo:calibratedProbability a owl:DatatypeProperty ;
    rdfs:label "calibrated probability"@en ;
    rdfs:comment "Present ONLY where a probabilistic model produced it. Absence is meaningful and must never be imputed."@en ;
    rdfs:domain bmo:ConfidenceAssessment ; rdfs:range xsd:decimal .
bmo:evidenceStrength a owl:DatatypeProperty ;
    rdfs:label "evidence strength"@en ; rdfs:domain bmo:ConfidenceAssessment ; rdfs:range xsd:string .
bmo:evidenceCompleteness a owl:DatatypeProperty ;
    rdfs:label "evidence completeness"@en ; rdfs:domain bmo:ConfidenceAssessment ; rdfs:range xsd:string .
bmo:assayApplicability a owl:DatatypeProperty ;
    rdfs:label "assay applicability"@en ;
    rdfs:comment "Whether the assay was validated for this pathogen, host, and matrix. The axis most often omitted and the one that matters most: an assay used outside its validation has no sensitivity figure that applies."@en ;
    rdfs:domain bmo:ConfidenceAssessment ; rdfs:range xsd:string .
bmo:provenanceQuality a owl:DatatypeProperty ;
    rdfs:label "provenance quality"@en ; rdfs:domain bmo:ConfidenceAssessment ; rdfs:range xsd:string .
