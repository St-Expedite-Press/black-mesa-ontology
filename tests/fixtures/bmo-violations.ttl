@prefix bmo:  <https://example.org/bmo/> .
@prefix up:   <https://example.org/upper/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Deliberate v0.3 violations. Every one exists because a test below expects the
# matching SHACL rule to reject it.

bmo:UnanchoredThing a owl:Class ;
    rdfs:label "Unanchored thing"@en .

# Shared helper data for deliberately invalid assertions.
bmo:FixtureZone a bmo:Zone .
bmo:FixtureAnomaly a bmo:ObservedAnomaly .
bmo:FixturePathogen a owl:NamedIndividual .
bmo:FixtureRule a up:RuleSetVersion .
bmo:FixtureAgent a prov:Agent .
bmo:FixtureSpecimen a bmo:Specimen .

bmo:FixtureProcedure a bmo:DiagnosticProcedure ;
    bmo:usedSpecimen bmo:FixtureSpecimen ;
    bmo:producedResult bmo:FixtureResult .

bmo:FixtureResult a bmo:DiagnosticResult ;
    bmo:producedByProcedure bmo:FixtureProcedure ;
    bmo:resultStatus bmo:PositiveResult .

bmo:FixtureCustodyEvent a bmo:SampleCollection ;
    bmo:occursAtZone bmo:FixtureZone ;
    bmo:yieldedSpecimen bmo:FixtureSpecimen ;
    bmo:eventAgent bmo:FixtureAgent ;
    bmo:eventTime "2026-09-12T12:00:00Z"^^xsd:dateTime .

bmo:FixtureCustody a bmo:CustodyRecord ;
    bmo:hasCustodyEvent bmo:FixtureCustodyEvent .

bmo:FixtureDiagnosticConfidence a bmo:ConfidenceAssessment ;
    bmo:evidenceStrength bmo:StrongEvidence ;
    bmo:evidenceCompleteness bmo:CompleteEvidence ;
    bmo:assayApplicability bmo:ValidatedApplicability ;
    bmo:provenanceQuality bmo:CompleteProvenance .

# Sensor indications may generate hypotheses, but they may not directly assert
# that a pathogen is present.
bmo:SensorClaimingPathogen a bmo:SensorIndicationAssertion ;
    bmo:concernsZone bmo:FixtureZone ;
    bmo:derivedFromAnomaly bmo:FixtureAnomaly ;
    bmo:assertsPathogen bmo:FixturePathogen ;
    bmo:hasEvidenceStage bmo:SensorIndicationStage ;
    bmo:hasConfidenceAssessment bmo:FixtureSensorConfidence ;
    up:generatedUnder bmo:FixtureRule ;
    prov:generatedAtTime "2026-09-12T12:10:00Z"^^xsd:dateTime .

bmo:FixtureSensorConfidence a bmo:ConfidenceAssessment ;
    bmo:evidenceStrength bmo:ModerateEvidence ;
    bmo:evidenceCompleteness bmo:PartialEvidence ;
    bmo:modelApplicability bmo:ValidatedApplicability ;
    bmo:provenanceQuality bmo:CompleteProvenance .

# A diagnostic determination without the custody record is scientifically
# interpretable but fails the Black Mesa evidentiary contract.
bmo:UntraceableDetection a bmo:DiagnosticDetectionAssertion ;
    bmo:concernsZone bmo:FixtureZone ;
    bmo:assertsPathogen bmo:FixturePathogen ;
    bmo:derivedFromResult bmo:FixtureResult ;
    bmo:hasEvidenceStage bmo:DiagnosticEvidenceStage ;
    bmo:hasDiagnosticDisposition bmo:Suspected ;
    bmo:hasConfidenceAssessment bmo:FixtureDiagnosticConfidence ;
    up:generatedUnder bmo:FixtureRule ;
    prov:generatedAtTime "2026-09-12T13:00:00Z"^^xsd:dateTime .

# A result without a disposition is not a complete diagnostic determination.
bmo:DetectionNoDisposition a bmo:DiagnosticDetectionAssertion ;
    bmo:concernsZone bmo:FixtureZone ;
    bmo:assertsPathogen bmo:FixturePathogen ;
    bmo:derivedFromResult bmo:FixtureResult ;
    bmo:hasEvidenceStage bmo:DiagnosticEvidenceStage ;
    bmo:hasConfidenceAssessment bmo:FixtureDiagnosticConfidence ;
    bmo:hasCustodyRecord bmo:FixtureCustody ;
    up:generatedUnder bmo:FixtureRule ;
    prov:generatedAtTime "2026-09-12T13:05:00Z"^^xsd:dateTime .

# Sensor-stage confidence must state whether the model is being used within its
# supported validation envelope.
bmo:BlindSensorConfidence a bmo:ConfidenceAssessment ;
    bmo:evidenceStrength bmo:ModerateEvidence ;
    bmo:evidenceCompleteness bmo:PartialEvidence ;
    bmo:provenanceQuality bmo:CompleteProvenance .

bmo:IndicationWithBlindConfidence a bmo:SensorIndicationAssertion ;
    bmo:concernsZone bmo:FixtureZone ;
    bmo:derivedFromAnomaly bmo:FixtureAnomaly ;
    bmo:hasEvidenceStage bmo:SensorIndicationStage ;
    bmo:hasConfidenceAssessment bmo:BlindSensorConfidence ;
    up:generatedUnder bmo:FixtureRule ;
    prov:generatedAtTime "2026-09-12T13:10:00Z"^^xsd:dateTime .

# Diagnostic-stage confidence must record assay/method applicability.
bmo:BlindDiagnosticConfidence a bmo:ConfidenceAssessment ;
    bmo:evidenceStrength bmo:StrongEvidence ;
    bmo:evidenceCompleteness bmo:CompleteEvidence ;
    bmo:provenanceQuality bmo:CompleteProvenance .

bmo:DetectionWithBlindConfidence a bmo:DiagnosticDetectionAssertion ;
    bmo:concernsZone bmo:FixtureZone ;
    bmo:assertsPathogen bmo:FixturePathogen ;
    bmo:derivedFromResult bmo:FixtureResult ;
    bmo:hasEvidenceStage bmo:DiagnosticEvidenceStage ;
    bmo:hasDiagnosticDisposition bmo:Suspected ;
    bmo:hasConfidenceAssessment bmo:BlindDiagnosticConfidence ;
    bmo:hasCustodyRecord bmo:FixtureCustody ;
    up:generatedUnder bmo:FixtureRule ;
    prov:generatedAtTime "2026-09-12T13:15:00Z"^^xsd:dateTime .

# A transfer with no receiving custodian is a custody break.
bmo:BrokenTransfer a bmo:TransferEvent ;
    bmo:custodySubject bmo:FixtureSpecimen ;
    bmo:fromCustodian bmo:FixtureAgent ;
    bmo:eventAgent bmo:FixtureAgent ;
    bmo:eventTime "2026-09-12T13:20:00Z"^^xsd:dateTime .

# Dense imagery must not be expanded into the semantic graph.
bmo:TiledImagery a bmo:ImageryReference ;
    bmo:storageURI "s3://fixture/image"^^xsd:anyURI ;
    bmo:checksum "fixture" ;
    bmo:pixelValue "0.41" .

# A crosswalk with no fidelity silently claims more equivalence than it knows.
bmo:SilentCrosswalk a bmo:ReportingCrosswalk ;
    up:crosswalkFrom bmo:Confirmed ;
    bmo:targetScheme bmo:NPDNDiagnosticConfidenceScheme ;
    up:crosswalkTo bmo:NPDNConfirmedTerm .

# If a mapping claims non-zero fidelity it must actually name the target term.
bmo:CrosswalkNoTarget a bmo:ReportingCrosswalk ;
    up:crosswalkFrom bmo:Confirmed ;
    bmo:targetScheme bmo:NPDNDiagnosticConfidenceScheme ;
    up:fidelity up:Exact .
