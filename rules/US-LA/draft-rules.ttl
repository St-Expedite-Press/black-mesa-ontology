@prefix rule: <https://w3id.org/black-mesa/rules/US-LA/> .
@prefix auth: <https://w3id.org/black-mesa/authority/> .
@prefix bmo:  <https://w3id.org/black-mesa/bmo/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

auth:US-LA-LDAF a prov:Organization ;
    rdfs:label "Louisiana Department of Agriculture and Forestry"@en .

rule:LA-PLANT-PEST-BASELINE-DRAFT a bmo:ReportingRule ;
    rdfs:label "Louisiana plant-pest/quarantine rule intake — DRAFT"@en ;
    bmo:ruleIdentifier "LA-PLANT-PEST-BASELINE-DRAFT" ;
    bmo:appliesInJurisdiction bmo:Louisiana ;
    bmo:regulatoryAuthority auth:US-LA-LDAF ;
    dct:source <https://www.ldaf.state.la.us/plants/pests> ;
    bmo:ruleReviewStatus bmo:DraftRequiresLegalRegulatoryReview ;
    bmo:requiresHumanReview true ;
    bmo:legalReviewNote "Verify Louisiana Horticulture and Quarantine requirements applicable to the relevant pest/pathogen, including reporting trigger, diagnostic confirmation, parish/quarantine geography, recipient, timing, regulated articles, and movement restrictions before approval."@en ;
    rdfs:comment "Non-operative intake record. No unverified legal trigger, deadline, or enforcement consequence is encoded. This record cannot authorize autonomous external notification."@en .
