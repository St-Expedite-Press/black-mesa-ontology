@prefix rule: <https://w3id.org/black-mesa/rules/US-OK/> .
@prefix auth: <https://w3id.org/black-mesa/authority/> .
@prefix bmo:  <https://w3id.org/black-mesa/bmo/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

auth:US-OK-ODAFF a prov:Organization ;
    rdfs:label "Oklahoma Department of Agriculture, Food and Forestry"@en .

rule:OK-PLANT-PEST-BASELINE-DRAFT a bmo:ReportingRule ;
    rdfs:label "Oklahoma plant-pest/quarantine rule intake — DRAFT"@en ;
    bmo:ruleIdentifier "OK-PLANT-PEST-BASELINE-DRAFT" ;
    bmo:appliesInJurisdiction bmo:Oklahoma ;
    bmo:regulatoryAuthority auth:US-OK-ODAFF ;
    dct:source <https://ag.ok.gov/plant-industry/> ;
    bmo:ruleReviewStatus bmo:DraftRequiresLegalRegulatoryReview ;
    bmo:requiresHumanReview true ;
    bmo:legalReviewNote "Verify current Oklahoma plant-industry quarantine and pest-survey requirements, including any Karnal bunt or other pathogen-specific trigger, confirmation method, regulated article, reporting recipient/deadline, geographic scope, and movement restrictions before approval."@en ;
    rdfs:comment "Non-operative intake record. No unverified legal trigger, deadline, or enforcement consequence is encoded. This record cannot authorize autonomous external notification."@en .
