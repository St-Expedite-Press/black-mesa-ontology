@prefix rule: <https://w3id.org/black-mesa/rules/US-MO/> .
@prefix auth: <https://w3id.org/black-mesa/authority/> .
@prefix bmo:  <https://w3id.org/black-mesa/bmo/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

auth:US-MO-MDA a prov:Organization ;
    rdfs:label "Missouri Department of Agriculture"@en .

rule:MO-PLANT-PEST-BASELINE-DRAFT a bmo:ReportingRule ;
    rdfs:label "Missouri plant-pest/quarantine rule intake — DRAFT"@en ;
    bmo:ruleIdentifier "MO-PLANT-PEST-BASELINE-DRAFT" ;
    bmo:appliesInJurisdiction bmo:Missouri ;
    bmo:regulatoryAuthority auth:US-MO-MDA ;
    dct:source <https://www.agriculture.mo.gov/plants/pests/> ;
    bmo:ruleReviewStatus bmo:DraftRequiresLegalRegulatoryReview ;
    bmo:requiresHumanReview true ;
    bmo:legalReviewNote "Verify the current Missouri Plant Pest Control authorities and any pest-specific quarantine rules, including regulated taxa/commodities, diagnostic threshold, reporting recipient and deadline, movement restrictions, and effective dates before approval."@en ;
    rdfs:comment "Non-operative intake record. No unverified legal trigger, deadline, or enforcement consequence is encoded. This record cannot authorize autonomous external notification."@en .
