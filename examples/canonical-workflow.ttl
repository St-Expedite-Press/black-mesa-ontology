@prefix ex:   <https://example.org/black-mesa/example/> .
@prefix bmo:  <https://example.org/bmo/> .
@prefix up:   <https://example.org/upper/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Canonical generic workflow. Sensor, crop, pathogen, and assay identifiers are
# placeholders; deployments should use canonical external identifiers.

ex:Farm-01 a bmo:Farm .
ex:Field-01 a bmo:Field ; bmo:partOfSite ex:Farm-01 .
ex:Zone-17 a bmo:Zone ; bmo:partOfSite ex:Field-01 .

ex:Sensor-A a sosa:Sensor .
ex:Platform-A a sosa:Platform .
ex:Model-v3 a up:RuleSetVersion .
ex:DiagnosticRule-v2 a up:RuleSetVersion .
ex:Collector-A a prov:Agent .
ex:Courier-A a prov:Agent .
ex:Lab-A a prov:Agent .
ex:Pathogen-Alpha a owl:NamedIndividual .

# 1. SENSOR-AGNOSTIC SURVEY

ex:Survey-100 a bmo:Flight ;
    bmo:usesSensor ex:Sensor-A ;
    bmo:hostedByPlatform ex:Platform-A ;
    bmo:madeObservation ex:Observation-100 ;
    bmo:observedAnomaly ex:Anomaly-100 .

ex:Observation-100 a bmo:SensorObservation .

ex:Support-100 a bmo:SpatialSupportDescription ;
    bmo:supportKind bmo:SensorFootprintSupport .

ex:Image-100 a bmo:ImageryReference ;
    bmo:storageURI "s3://black-mesa-example/survey-100/source-artifact"^^xsd:anyURI ;
    bmo:checksum "sha256:EXAMPLE-NOT-A-REAL-HASH" .

ex:Anomaly-100 a bmo:ObservedAnomaly ;
    bmo:derivedFromObservation ex:Observation-100 ;
    bmo:referencesImagery ex:Image-100 ;
    bmo:hasSpatialSupport ex:Support-100 .

# 2. SENSOR INDICATION — IT DOES NOT ASSERT A PATHOGEN

ex:SensorConfidence-100 a bmo:ConfidenceAssessment ;
    bmo:calibratedProbability "0.72"^^xsd:decimal ;
    bmo:evidenceStrength bmo:ModerateEvidence ;
    bmo:evidenceCompleteness bmo:PartialEvidence ;
    bmo:modelApplicability bmo:ValidatedApplicability ;
    bmo:provenanceQuality bmo:CompleteProvenance .

ex:Indication-100 a bmo:SensorIndicationAssertion ;
    bmo:concernsZone ex:Zone-17 ;
    bmo:derivedFromAnomaly ex:Anomaly-100 ;
    bmo:hasEvidenceStage bmo:SensorIndicationStage ;
    bmo:hasConfidenceAssessment ex:SensorConfidence-100 ;
    up:generatedUnder ex:Model-v3 ;
    prov:generatedAtTime "2026-09-12T15:00:00Z"^^xsd:dateTime .

# 3. COMPETING HYPOTHESES

ex:Hypothesis-Pathogen a bmo:DiagnosticHypothesis ;
    bmo:concernsZone ex:Zone-17 ;
    bmo:hypothesizesAgent ex:Pathogen-Alpha ;
    bmo:candidateProbability "0.55"^^xsd:decimal ;
    bmo:candidateRank 1 .

ex:Hypothesis-WaterStress a bmo:DiagnosticHypothesis ;
    bmo:concernsZone ex:Zone-17 ;
    bmo:hypothesizesAgent ex:WaterStress ;
    bmo:candidateProbability "0.31"^^xsd:decimal ;
    bmo:candidateRank 2 .

ex:Candidates-100 a bmo:DiagnosticCandidateSet ;
    bmo:hasCandidate ex:Hypothesis-Pathogen, ex:Hypothesis-WaterStress .

# 4. PHYSICAL SAMPLE AND CUSTODY

ex:Specimen-100 a bmo:Specimen .

ex:Collection-100 a bmo:SampleCollection ;
    bmo:occursAtZone ex:Zone-17 ;
    bmo:yieldedSpecimen ex:Specimen-100 ;
    bmo:eventAgent ex:Collector-A ;
    bmo:eventTime "2026-09-12T16:05:00Z"^^xsd:dateTime ;
    bmo:containerIdentifier "C-100" ;
    bmo:sealIdentifier "SEAL-100" .

ex:Transfer-100 a bmo:TransferEvent ;
    bmo:custodySubject ex:Specimen-100 ;
    bmo:fromCustodian ex:Collector-A ;
    bmo:toCustodian ex:Courier-A ;
    bmo:eventAgent ex:Collector-A ;
    bmo:eventTime "2026-09-12T16:20:00Z"^^xsd:dateTime ;
    bmo:previousCustodyEvent ex:Collection-100 ;
    bmo:containerIdentifier "C-100" ;
    bmo:sealIdentifier "SEAL-100" ;
    bmo:tamperStatus "intact" .

ex:Receipt-100 a bmo:ReceiptEvent ;
    bmo:custodySubject ex:Specimen-100 ;
    bmo:toCustodian ex:Lab-A ;
    bmo:eventAgent ex:Lab-A ;
    bmo:eventTime "2026-09-12T18:15:00Z"^^xsd:dateTime ;
    bmo:previousCustodyEvent ex:Transfer-100 ;
    bmo:containerIdentifier "C-100" ;
    bmo:sealIdentifier "SEAL-100" ;
    bmo:tamperStatus "intact" .

ex:CustodyRecord-100 a bmo:CustodyRecord ;
    bmo:hasCustodyEvent ex:Collection-100, ex:Transfer-100, ex:Receipt-100 .

# 5. DIAGNOSTIC PROCEDURE AND RESULT

ex:Assay-100 a bmo:Assay ;
    bmo:usedSpecimen ex:Specimen-100 ;
    bmo:producedResult ex:Result-100 .

ex:Result-100 a bmo:AssayResult ;
    bmo:producedByProcedure ex:Assay-100 ;
    bmo:resultStatus bmo:PositiveResult .

ex:DiagnosticConfidence-100 a bmo:ConfidenceAssessment ;
    bmo:evidenceStrength bmo:VeryStrongEvidence ;
    bmo:evidenceCompleteness bmo:CompleteEvidence ;
    bmo:assayApplicability bmo:ValidatedApplicability ;
    bmo:provenanceQuality bmo:CompleteProvenance .

# 6. SCIENTIFIC DETERMINATION

ex:Detection-100 a bmo:ConfirmedDetectionAssertion ;
    bmo:concernsZone ex:Zone-17 ;
    bmo:assertsPathogen ex:Pathogen-Alpha ;
    bmo:derivedFromResult ex:Result-100 ;
    bmo:hasCustodyRecord ex:CustodyRecord-100 ;
    bmo:hasEvidenceStage bmo:ConfirmatoryEvidenceStage ;
    bmo:hasDiagnosticDisposition bmo:Confirmed ;
    bmo:hasConfidenceAssessment ex:DiagnosticConfidence-100 ;
    up:generatedUnder ex:DiagnosticRule-v2 ;
    prov:generatedAtTime "2026-09-12T19:00:00Z"^^xsd:dateTime ;
    bmo:appliesInJurisdiction bmo:Arkansas .
